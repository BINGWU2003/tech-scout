# 全仓库共用的数据库连接；各服务 .env 不再配置数据库 URL。
# sslrootcert 使用 config/supabase-ca.crt 的绝对路径，空格等特殊字符需 URL 编码。
DATABASE_URL=postgresql://tech_scout_app:replace-with-your-password@db.kuztkaiftsgkzhweamdn.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/tech-scout/config/supabase-ca.crt
