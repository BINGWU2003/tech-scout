# 数据库连接统一配置在仓库根目录 .env 的 DATABASE_URL。
INTELLIGENCE_INTERNAL_TOKEN=replace-with-a-random-token-at-least-32-characters
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RESEARCH_MAX_SECONDS=3600
RESEARCH_MAX_REQUESTS=300
RESEARCH_MAX_CNY=10
RESEARCH_OUTPUT_TOKENS=8192
RESEARCH_INPUT_CNY_PER_MILLION=3
RESEARCH_OUTPUT_CNY_PER_MILLION=9
RESEARCH_MODEL_TIMEOUT_SECONDS=60
RESEARCH_MAX_PARALLEL=2

ACQUISITION_BROWSER_CHANNEL=chrome
ACQUISITION_INTERVAL_SECONDS=5
ACQUISITION_COMPANY_CACHE_DAYS=30
