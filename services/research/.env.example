INTELLIGENCE_DATABASE_URL=postgresql://tech_scout_agent:replace-with-password@localhost:5432/tech-scout
INTELLIGENCE_INTERNAL_TOKEN=replace-with-a-random-token-at-least-32-characters
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RESEARCH_MAX_SECONDS=300
RESEARCH_MAX_REQUESTS=6
RESEARCH_MAX_CNY=1
RESEARCH_OUTPUT_TOKENS=8192
RESEARCH_INPUT_CNY_PER_MILLION=3
RESEARCH_OUTPUT_CNY_PER_MILLION=9
RESEARCH_MODEL_TIMEOUT_SECONDS=60
RESEARCH_MAX_PARALLEL=2

ACQUISITION_DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech-scout
ACQUISITION_BROWSER_CHANNEL=chrome
ACQUISITION_INTERVAL_SECONDS=5
ACQUISITION_PATENT_LIMIT=100
ACQUISITION_COMPANY_CACHE_DAYS=30

# 可选：数据库集成测试。只使用独立测试库，库名必须以 _test 结尾。
# pytest 从本目录 .env 读取 TEST_*；进程环境变量优先。
# 不配置时跳过依赖数据库的测试。
# TEST_ACQUISITION_DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech_scout_test
# TEST_INTELLIGENCE_DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech_scout_test
