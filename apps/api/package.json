{
  "name": "@tech-scout/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate && prisma generate --config prisma.catalog.config.ts",
    "intelligence:client": "openapi-ts",
    "intelligence:client:check": "node scripts/check-intelligence-client.mjs",
    "prisma:validate": "prisma validate && prisma validate --config prisma.catalog.config.ts",
    "prisma:migrate": "prisma migrate deploy",
    "admin:create": "pnpm prisma:generate && nest build && node dist/cli/create-admin.js",
    "test": "pnpm prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "pnpm prisma:generate"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@tech-scout/contracts": "workspace:*",
    "@tech-scout/shared": "workspace:*",
    "argon2": "catalog:",
    "cookie-parser": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/mau": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
