PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech-scout
CATALOG_DATABASE_URL=postgresql://tech_scout_catalog_reader:replace-with-your-password@localhost:5432/tech-scout
WEB_ORIGIN=http://192.168.3.25:8848
SESSION_COOKIE_SECURE=false

ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=

INTELLIGENCE_URL=http://127.0.0.1:8001
INTELLIGENCE_INTERNAL_TOKEN=replace-with-the-same-random-token-as-python

# 可选：数据库集成测试。只使用独立测试库，库名必须以 _test 结尾。
# 测试命令从本目录 .env 读取 TEST_*；进程环境变量优先。
# 不配置时跳过依赖数据库的测试。
# TEST_DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech_scout_test?schema=app
# TEST_CATALOG_DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/tech_scout_test
# 真实服务联调需另启连接独立测试库的研究服务。
# TEST_INTELLIGENCE_URL=http://127.0.0.1:8101
