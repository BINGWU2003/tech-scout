{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles/index.css",
    "functions": ["cn", "clsx"]
  }
}
